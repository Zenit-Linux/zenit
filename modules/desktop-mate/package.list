# --- MATE -- pełny zestaw pakietów środowiska (backend: apt) ---
# v0.5: usunięty PLACEHOLDER, patrz uwaga w modules/desktop-gnome/package.list.
package "zenit-desktop-mate" {
  backend     = "own"
  description = "Metapakiet MATE dla instalatora -- rozwija się na pakiety poniżej"
}

# --- sesja / kompozytor / menedżer logowania ---
package "mate-session-manager" {
  backend = "apt"
}
package "marco" {
  backend     = "apt"
  description = "menedżer okien MATE (fork Metacity)"
}
package "mate-panel" {
  backend = "apt"
}
package "mate-desktop-environment-core" {
  backend     = "apt"
  description = "lżejszy rdzeń MATE (bez pełnego zestawu apletów -- reszta poniżej dołożona jawnie)"
}
package "lightdm" {
  backend = "apt"
}
package "lightdm-gtk-greeter" {
  backend = "apt"
}

# --- podstawowe aplikacje ---
package "caja" {
  backend     = "apt"
  description = "menedżer plików (fork Nautilusa)"
}
package "mate-terminal" {
  backend = "apt"
}
package "pluma" {
  backend     = "apt"
  description = "edytor tekstu (fork gedita)"
}
package "atril" {
  backend     = "apt"
  description = "przeglądarka dokumentów/PDF (fork Evince)"
}
package "eom" {
  backend     = "apt"
  description = "przeglądarka obrazów (Eye of MATE)"
}
package "engrampa" {
  backend     = "apt"
  description = "archiwizator (fork File Roller)"
}
package "mate-control-center" {
  backend = "apt"
}
package "mate-system-monitor" {
  backend = "apt"
}
package "mate-power-manager" {
  backend = "apt"
}
package "mate-screensaver" {
  backend = "apt"
}

# --- integracja sprzętowa / systemowa ---
package "network-manager-gnome" {
  backend = "apt"
}
package "gvfs-backends" {
  backend = "apt"
}
package "mate-media" {
  backend = "apt"
}
package "mate-applet-appmenu" {
  backend = "apt"
}

# --- audio (PipeWire) ---
package "pipewire" {
  backend = "apt"
}
package "pipewire-pulse" {
  backend = "apt"
}
package "wireplumber" {
  backend = "apt"
}
