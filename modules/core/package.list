# --- system bazowy (backend domyślny: apt) ---
package "base" {}
package "linux-firmware" {}

package "systemd" {
  backend = "apt"
}
package "network-manager" {
  backend     = "apt"
  description = "NAPRAWIONE: prawdziwa nazwa pakietu Ubuntu/Debian to 'network-manager' (z myślnikiem) -- 'networkmanager' (jedno słowo) nie istnieje w apt, apt-get zwracał 'E: Unable to locate package networkmanager'"
}
package "grub-pc" {
  backend     = "apt"
  arch        = "x86_64"
  description = "GRUB dla BIOS/legacy boot (x86_64) -- razem z grub-efi-amd64 daje hybrydowe ISO (BIOS+UEFI), najszersza kompatybilność ze sprzętem/VM. Zweryfikowane realnie: pakiet istnieje w archive.ubuntu.com."
}
package "grub-efi-amd64" {
  backend     = "apt"
  arch        = "x86_64"
  description = "GRUB dla UEFI (x86_64). Zweryfikowane realnie: pakiet istnieje w archive.ubuntu.com."
}
package "grub-efi-arm64" {
  backend     = "apt"
  arch        = "aarch64"
  description = "GRUB dla UEFI (aarch64 nie wspiera legacy BIOS, więc tylko ten wariant). Zweryfikowane realnie względem indeksu binary-arm64 w archive.ubuntu.com."
}
package "efibootmgr" {
  backend = "apt"
}

# --- ekosystem Zenit, zawsze przez "own" (bez curl) ---
package "zpm" {
  backend     = "own"
  description = "Zenit Package Manager -- wbudowany, domyślny"
}
package "installer" {
  backend = "own"
}
package "kernel" {
  backend     = "own"
  variant     = "stable"
  description = "domyślne jądro Linux (branch: stable; dostępne też: rolling/semi-rolling/testing)"
}
package "zenit-base" {
  backend     = "own"
  description = "NAPRAWIONE: wszystkie \"coreutils\" Zenita (init system zsrv, bootloader zboot, itd.) są w JEDNYM pakiecie 'zenit-base' w own-repository.json -- nie ma osobnych 'zsrv'/'zboot' do zainstalowania, więc nie dublujemy tego jako osobne wpisy niżej"
}

# --- narzędzia dodatkowe z jawnie wybranych backendów ---
package "htop" {
  backend = "apt"
}
package "neovim" {
  backend = "apt"
}
package "git" {
  backend = "apt"
  # przykład instalacji cross-distro (bezpieczna, izolowana -- patrz
  # zpm/crossdistro.nim): odkomentuj, żeby pobrać z Debiana testing
  # zamiast z natywnych repo hosta.
  # variant = "debian.testing"
}
package "cargo" {
  backend     = "apt"
  description = "NAPRAWIONE: wymagane PRZED 'ripgrep' (backend cargo) -- bez tego runInChroot w zpm dostaje '/bin/sh: 1: cargo: not found', bo w świeżo zbootstrapowanym rootfs nie ma jeszcze żadnego Rust/cargo"
}
package "ripgrep" {
  backend = "cargo"
}
package "flatpak" {
  backend     = "apt"
  description = "NAPRAWIONE: wymagane PRZED 'firefox' (backend flatpak) -- bez tego runInChroot w zpm dostaje '/bin/sh: 1: flatpak: not found'"
}
package "org.mozilla.firefox" {
  backend     = "flatpak"
  description = "NAPRAWIONE: Flatpak wymaga pelnego ID aplikacji w formacie reverse-DNS (min. 2 kropki) -- 'firefox' samo w sobie odrzucane bledem 'Invalid id firefox: Names must contain at least 2 periods'. Prawdziwe ID na Flathub to 'org.mozilla.firefox'."
}

# --- pakiet bez żadnych opcji: backend wzięty z domyślnej dystrybucji
#     zadeklarowanej w distro.hcl (distro.base / distro.default_backend) ---
package "curl" {}
